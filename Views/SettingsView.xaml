<UserControl x:Class="DoodleDrive.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:h="clr-namespace:DoodleDrive.Helpers"
             xmlns:vm="clr-namespace:DoodleDrive.ViewModels"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Paramètres" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="Connexions et apparence" Opacity="0.65" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">

                <!-- Apparence -->
                <Border CornerRadius="10" Padding="18" Margin="0,0,0,14"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="Apparence" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Thème" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding ThemeOptions}"
                                          SelectedItem="{Binding Theme, Mode=TwoWay}" MinHeight="36" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Vue par défaut" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding ViewOptions}"
                                          SelectedItem="{Binding DefaultView, Mode=TwoWay}" MinHeight="36" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="Lancer Doodle Drive au démarrage de Windows"
                                  IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}"
                                  Margin="0,14,0,0" />
                        <CheckBox Content="Ouvrir aussi la fenêtre (sinon démarre en tâche de fond)"
                                  IsChecked="{Binding OpenWindowOnStartup, Mode=TwoWay}"
                                  IsEnabled="{Binding LaunchAtStartup}"
                                  Margin="24,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Serveur (admin) -->
                <Border CornerRadius="10" Padding="18" Margin="0,0,0,14"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Serveur" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,0,0,10"
                                   Text="Adresse publique du serveur Doodle Drive (API + partages, ex. via Tailscale Funnel). C'est le point d'entrée unique de l'application : connexion, fichiers et liens de partage passent tous par cette URL." />
                        <ui:TextBox Text="{Binding ShareBaseUrl, Mode=TwoWay}" MinHeight="36"
                                    PlaceholderText="https://debianregion.xxxx.ts.net" />
                    </StackPanel>
                </Border>

                <!-- Accès direct (tous les utilisateurs) -->
                <Border CornerRadius="10" Padding="18" Margin="0,0,0,14"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="Accès direct" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,0,0,10"
                                   Text="Si ce PC est connecté au même réseau Tailscale que le serveur, l'application lui parle directement (chiffré, bien plus rapide pour les gros fichiers) au lieu de passer par Internet. Elle bascule automatiquement sur Internet si l'accès direct ne répond pas. L'état actuel est affiché en bas de la barre latérale." />
                        <CheckBox Content="Utiliser l'accès direct quand il est disponible"
                                  IsChecked="{Binding PreferDirect, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- Lecteur réseau WebDAV (tous les utilisateurs) -->
                <Border CornerRadius="10" Padding="18" Margin="0,0,0,14"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="Lecteur réseau (WebDAV)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,0,0,10"
                                   Text="Ouvrez votre drive directement dans l'Explorateur Windows (comme un disque Z:), ou dans toute app compatible WebDAV : gestionnaire de fichiers Android, Obsidian, KeePass, VLC… Identifiant et mot de passe : ceux de votre compte Doodle Drive. Les suppressions vont dans la Corbeille." />
                        <ui:TextBox Text="{Binding WebDavUrl, Mode=OneWay}" IsReadOnly="True" MinHeight="36" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Command="{Binding CopyWebDavCommand}" Appearance="Secondary" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8C8;" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="Copier l'adresse" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Command="{Binding MapDriveCommand}" Appearance="Primary">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8CE;" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="Connecter un lecteur réseau…" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Opacity="0.55" FontSize="11" Margin="0,10,0,0"
                                   Text="Dans l'assistant : choisissez une lettre, collez l'adresse (déjà copiée) dans « Dossier », cochez « Se reconnecter lors de la connexion », puis saisissez vos identifiants. Pour les gros fichiers, préférez l'envoi depuis l'application (reprise automatique en cas de coupure)." />
                    </StackPanel>
                </Border>

                <!-- Mises à jour (tous les utilisateurs) -->
                <Border CornerRadius="10" Padding="18" Margin="0,0,0,14"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="Mises à jour" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,0,0,10">
                            <Run Text="Version installée :" />
                            <Run Text="{Binding AppVersion, Mode=OneWay}" FontWeight="SemiBold" />
                            <LineBreak />
                            <Run Text="L'application vérifie automatiquement les mises à jour au démarrage." />
                        </TextBlock>
                        <ui:Button Command="{Binding CheckUpdatesCommand}" Appearance="Secondary"
                                   HorizontalAlignment="Left" Content="Rechercher des mises à jour" />
                    </StackPanel>
                </Border>

                <!-- Connexion (tous les utilisateurs) -->
                <Border CornerRadius="10" Padding="18" Margin="0,0,0,14"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="Connexion" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,0,0,12"
                                   Text="Réinitialise l'adresse du serveur. Vous serez déconnecté immédiatement ; l'app redemandera l'URL du serveur et vos identifiants à la prochaine connexion." />
                        <ui:Button Command="{Binding ResetConnectionCommand}" Appearance="Secondary"
                                   HorizontalAlignment="Left" Content="Réinitialiser la connexion…" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button Content="Enregistrer" Appearance="Primary" MinWidth="120" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
