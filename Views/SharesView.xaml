<UserControl x:Class="DoodleDrive.Views.SharesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:DoodleDrive.ViewModels"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:SharesViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Mes partages" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Liens de partage que vous avez créés" Opacity="0.65" />
            </StackPanel>
            <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Appearance="Secondary"
                       Command="{Binding RefreshCommand}" ToolTip="Actualiser">
                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE72C;" FontSize="15" />
            </ui:Button>
        </Grid>

        <!-- Avertissement si l'URL de partage n'est pas configurée -->
        <Border Grid.Row="1" Margin="0,0,0,10" CornerRadius="8" Padding="12,10"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                Visibility="{Binding IsShareNotConfigured, Converter={StaticResource BoolToVis}}">
            <TextBlock TextWrapping="Wrap" Opacity="0.85" FontSize="12"
                       Text="L'URL du serveur de partage n'est pas configurée (Paramètres → Partage par lien). Les liens ne pourront pas être copiés ni ouverts tant qu'elle est vide." />
        </Border>

        <Border Grid.Row="2" CornerRadius="10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <!-- État vide -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource GlyphText}" Text="&#xE71B;" FontSize="46" Opacity="0.25" />
                    <TextBlock Text="Aucun lien de partage pour l'instant." Opacity="0.6" Margin="0,10,0,0" />
                    <TextBlock Text="Clic droit sur un fichier → « Partager par lien… »" Opacity="0.4"
                               FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Liste des partages -->
                <ui:ListView ItemsSource="{Binding Shares}" Background="Transparent" BorderThickness="0">
                    <ui:ListView.View>
                        <GridView>
                            <GridViewColumn Width="240" Header="Fichier">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource GlyphText}" Text="{Binding Glyph}" FontSize="15"
                                                       Foreground="{StaticResource KindFolderBrush}" Opacity="0.85" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="110" Header="Type" DisplayMemberBinding="{Binding ModeText}" />
                            <GridViewColumn Width="130" Header="Créé le" DisplayMemberBinding="{Binding CreatedText}" />
                            <GridViewColumn Width="130" Header="Expire" DisplayMemberBinding="{Binding ExpiryText}" />
                            <GridViewColumn Width="60" Header="Vues" DisplayMemberBinding="{Binding ViewCount}" />
                            <GridViewColumn Width="90" Header="Statut">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource ToastSuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="150" Header="Actions">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                            <ui:Button Appearance="Secondary" Margin="0,0,6,0" Padding="6" ToolTip="Copier le lien"
                                                       Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                       CommandParameter="{Binding}">
                                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8C8;" FontSize="13" />
                                            </ui:Button>
                                            <ui:Button Appearance="Secondary" Margin="0,0,6,0" Padding="6" ToolTip="Ouvrir dans le navigateur"
                                                       Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                       CommandParameter="{Binding}">
                                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE774;" FontSize="13" />
                                            </ui:Button>
                                            <ui:Button Appearance="Secondary" Padding="6" ToolTip="Révoquer le lien"
                                                       Command="{Binding DataContext.RevokeCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                       CommandParameter="{Binding}">
                                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE74D;" FontSize="13" />
                                            </ui:Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ui:ListView.View>
                </ui:ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
