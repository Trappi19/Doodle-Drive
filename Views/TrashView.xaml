<UserControl x:Class="DoodleDrive.Views.TrashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:DoodleDrive.ViewModels"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:TrashViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Corbeille" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="{Binding Subtitle}" Opacity="0.65" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Margin="0,0,8,0" />
                    <TextBlock Text="Actualisation…" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                </StackPanel>
                <ui:Button Appearance="Secondary" Command="{Binding EmptyCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE74D;" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="Vider la corbeille" />
                    </StackPanel>
                </ui:Button>
                <ui:Button Appearance="Secondary" Command="{Binding RefreshCommand}" ToolTip="Actualiser">
                    <TextBlock Style="{StaticResource GlyphText}" Text="&#xE72C;" FontSize="15" />
                </ui:Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" CornerRadius="10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <!-- Premier chargement -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsFirstLoading, Converter={StaticResource BoolToVis}}">
                    <ui:ProgressRing Width="40" Height="40" IsIndeterminate="True" HorizontalAlignment="Center" />
                    <TextBlock Text="Chargement de la corbeille…" Opacity="0.6" Margin="0,14,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Échec du chargement -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                            Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource GlyphText}" Text="&#xE783;" FontSize="40" Opacity="0.35" HorizontalAlignment="Center" />
                    <TextBlock Text="Impossible de charger la corbeille." Opacity="0.7" Margin="0,10,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding LoadError}" Opacity="0.45" FontSize="12" Margin="0,4,0,0"
                               TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                    <ui:Button Content="Réessayer" Appearance="Secondary" Margin="0,12,0,0" HorizontalAlignment="Center"
                               Command="{Binding RefreshCommand}" />
                </StackPanel>

                <!-- Vide -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource GlyphText}" Text="&#xE74D;" FontSize="46" Opacity="0.25" HorizontalAlignment="Center" />
                    <TextBlock Text="La corbeille est vide." Opacity="0.6" Margin="0,10,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="Les éléments supprimés arrivent ici et peuvent être restaurés." Opacity="0.4"
                               FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <ui:ListView ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0">
                    <ui:ListView.View>
                        <GridView>
                            <GridViewColumn Width="250" Header="Nom">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource GlyphText}" Text="{Binding Glyph}" FontSize="16"
                                                       Foreground="{Binding AccentBrushKey, Converter={StaticResource KeyToBrush}}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="230" Header="Emplacement d'origine">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LocationText}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding LocationText}" Opacity="0.8" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="130" Header="Supprimé le" DisplayMemberBinding="{Binding DeletedText}" />
                            <GridViewColumn Width="90" Header="Taille" DisplayMemberBinding="{Binding SizeText}" />
                            <GridViewColumn Width="100" Header="Par" DisplayMemberBinding="{Binding DeletedBy}" />
                            <GridViewColumn Width="90" Header="Effacé" DisplayMemberBinding="{Binding ExpiresText}" />
                            <GridViewColumn Width="110" Header="Actions">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Appearance="Primary" Margin="0,0,6,0" Padding="6" ToolTip="Restaurer à son emplacement d'origine"
                                                       Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                       CommandParameter="{Binding}">
                                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE7A7;" FontSize="13" />
                                            </ui:Button>
                                            <ui:Button Appearance="Secondary" Padding="6" ToolTip="Supprimer définitivement"
                                                       Command="{Binding DataContext.DeleteForeverCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                       CommandParameter="{Binding}">
                                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE74D;" FontSize="13" />
                                            </ui:Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ui:ListView.View>
                </ui:ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
