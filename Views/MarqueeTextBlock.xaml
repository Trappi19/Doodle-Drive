<UserControl x:Class="DoodleDrive.Views.MarqueeTextBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             ClipToBounds="True" Background="Transparent"
             MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">
    <!-- Canvas : taille désirée nulle -> le UserControl épouse la largeur VISIBLE (colonne),
         et le texte peut déborder librement (coupé par ClipToBounds). Conteneur idéal pour marquee. -->
    <Canvas>
        <TextBlock x:Name="Inner" Canvas.Left="0" Canvas.Top="1"
                   Text="{Binding Text, ElementName=Root}"
                   TextWrapping="NoWrap" TextTrimming="None">
            <TextBlock.RenderTransform>
                <TranslateTransform x:Name="Xform" />
            </TextBlock.RenderTransform>
        </TextBlock>
    </Canvas>
</UserControl>
