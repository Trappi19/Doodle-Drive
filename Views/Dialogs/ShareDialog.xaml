<ui:FluentWindow x:Class="DoodleDrive.Views.Dialogs.ShareDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Partager"
                 Width="460" SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Partager par lien" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,12,24,8">
            <TextBlock x:Name="FileNameText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="Créer un lien public accessible à toute personne qui le reçoit, même sans l'application."
                       Margin="0,4,0,14" Opacity="0.75" FontSize="12" TextWrapping="Wrap" />

            <TextBlock Text="Ce que la personne peut faire" FontWeight="SemiBold" Margin="0,0,0,6" />
            <RadioButton x:Name="PreviewRadio" GroupName="Mode" IsChecked="True" Margin="0,2"
                         Content="Voir l'aperçu seulement (image, vidéo, PDF…)" />
            <RadioButton x:Name="DownloadRadio" GroupName="Mode" Margin="0,2"
                         Content="Télécharger le fichier" />

            <TextBlock Text="Expiration du lien" FontWeight="SemiBold" Margin="0,16,0,6" />
            <ComboBox x:Name="ExpiryBox" MinHeight="36" SelectedIndex="1">
                <ComboBoxItem Content="Jamais" Tag="0" />
                <ComboBoxItem Content="24 heures" Tag="1" />
                <ComboBoxItem Content="7 jours" Tag="7" />
                <ComboBoxItem Content="30 jours" Tag="30" />
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,16,24,20">
            <ui:Button Content="Annuler" Appearance="Secondary" IsCancel="True"
                       MinWidth="96" Margin="0,0,10,0" Click="Cancel_OnClick" />
            <ui:Button Content="Créer le lien" Appearance="Primary"
                       IsDefault="True" MinWidth="120" Click="Ok_OnClick" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
